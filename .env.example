# --- Credentials (never bake into Docker images) ---
GOOGLE_APPLICATION_CREDENTIALS=.secrets/service-account.json
GA4_PROPERTY_ID=123456789
# Match GA4 Admin → Property settings → Reporting time zone
GA4_REPORTING_TIMEZONE=Asia/Kolkata

# --- Google Cloud APIs ---
# Enable "Google Sheets API" on the GCP project used by the service account.
# Share target spreadsheets with the service account email (Editor).

# Optional default spreadsheet for ops/docs (export API still requires spreadsheet_id)
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=your-google-sheets-spreadsheet-id

# --- Google Analytics MCP (Streamable HTTP) ---
# Local dev (connector on host): MCP server on localhost
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# Docker Compose: connector uses internal hostname (set in docker-compose.yml)
# MCP_SERVER_URL=http://analytics-mcp:8080/mcp
MCP_TIMEOUT=30

# --- KartmaX Backend REST API ---
# Legacy (temporary): X-API-Key header
KARTMAX_API_KEY=change-me-to-a-long-random-secret
# Recommended: JWT client credentials (server-to-server)
JWT_SIGNING_SECRET=change-me-to-at-least-32-random-characters
JWT_ISSUER=kartmax-ga4-connector
JWT_AUDIENCE=kartmax-backend
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
# JSON array of OAuth clients (property allowlist per client)
KARTMAX_OAUTH_CLIENTS=[{"client_id":"kartmax-backend","client_secret":"change-me-client-secret","property_ids":["123456789"],"scopes":["reports:gmv","reports:sessions","health:read"]}]
REPORT_MAX_RANGE_DAYS=366

# --- Runtime profile ---
# Production API-only: ENABLE_DASHBOARD=false, ENABLE_OPS_CONSOLE=true (recommended)
# Legacy unauthenticated channel dashboard (dev only): ENABLE_DASHBOARD=true
ENABLE_DASHBOARD=true
# JWT ops console at /ops — uses /api/v1 only; no secrets stored in browser
ENABLE_OPS_CONSOLE=false

# --- Docker Compose helpers (host paths only) ---
# Absolute or repo-relative path to service account JSON on the host
GOOGLE_APPLICATION_CREDENTIALS_HOST=.secrets/service-account.json
CONNECTOR_HOST_PORT=8080