# Official Google Analytics MCP server (HTTP / Streamable).
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    ANALYTICS_MCP_STATELESS_HTTP=true

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir "analytics-mcp==1.1.0"

RUN groupadd --system --gid 1001 mcp \
    && useradd --system --uid 1001 --gid mcp mcp

USER mcp

EXPOSE 8080

CMD ["analytics-mcp", "--transport", "http", "--stateless-http", "--host", "0.0.0.0", "--port", "8080"]